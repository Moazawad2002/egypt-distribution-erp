datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Organization & Access Control
// ----------------------------------------------------

enum RoleType {
  CEO
  BRANCH_MANAGER
  ACCOUNTANT
  INVENTORY_STAFF
  SALES_REP
  ADMIN
}

model Branch {
  id          String   @id @default(uuid())
  code        String   @unique // CAI, ALX, MNS
  nameEn      String   @map("name_en")
  nameAr      String   @map("name_ar")
  address     String?
  phone       String?
  colorCode   String   @default("#1E3A8A") @map("color_code") // Blue, Teal, Green
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users               User[]
  salesReps           SalesRepresentative[]
  customers           Customer[]
  warehouses          Warehouse[]
  salesInvoices       SalesInvoice[]
  salesReturns        SalesReturn[]
  expenses            Expenses[]
  branchBudgets       BranchBudget[]
  customerPayments    CustomerPayment[]
  creditNotes         CreditNote[]
  deliveries          Delivery[]
  operationalAlerts   OperationalAlert[]
  auditLogs           AuditLog[]

  @@map("branches")
}

model Role {
  id          String    @id @default(uuid())
  name        RoleType  @unique
  description String?
  permissions Json      @default("[]") // Array of string permissions
  createdAt   DateTime  @default(now()) @map("created_at")

  users       User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  branchId     String?   @map("branch_id")
  roleId       String    @map("role_id")
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  branch       Branch?   @relation(fields: [branchId], references: [id])
  role         Role      @relation(fields: [roleId], references: [id])

  salesRep             SalesRepresentative?
  auditLogs            AuditLog[]
  discountApprovals    DiscountApproval[]    @relation("ApprovedDiscounts")
  requestedDiscounts   DiscountApproval[]    @relation("RequestedDiscounts")
  approvedReturns      SalesReturn[]         @relation("ApprovedReturns")
  approvedAdjustments  StockAdjustment[]
  createdPayments      CustomerPayment[]
  approvedExpenses     Expenses[]
  approvedCommissions  CommissionCalculation[]
  importJobs           ImportJob[]

  @@map("users")
}

model SalesRepresentative {
  id             String    @id @default(uuid())
  branchId       String    @map("branch_id")
  userId         String?   @unique @map("user_id")
  code           String    @unique
  name           String
  phone          String?
  email          String?
  hireDate       DateTime  @default(now()) @map("hire_date")
  commissionRate Decimal   @default(0.02) @db.Decimal(5, 4) @map("commission_rate") // e.g. 0.0200 = 2%
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  branch         Branch    @relation(fields: [branchId], references: [id])
  user           User?     @relation(fields: [userId], references: [id])

  targets        SalesTarget[]
  invoices       SalesInvoice[]
  commissions    CommissionCalculation[]

  @@map("sales_representatives")
}

model SalesTarget {
  id                    String              @id @default(uuid())
  salesRepresentativeId String              @map("sales_representative_id")
  periodYear            Int                 @map("period_year")
  periodMonth           Int                 @map("period_month")
  targetAmount          Decimal             @db.Decimal(14, 2) @map("target_amount")
  targetType            String              @default("NET_SALES") @map("target_type") // NET_SALES or GROSS_SALES
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at")

  salesRepresentative   SalesRepresentative @relation(fields: [salesRepresentativeId], references: [id])

  @@unique([salesRepresentativeId, periodYear, periodMonth])
  @@map("sales_targets")
}

// ----------------------------------------------------
// Master Catalog, Warehouses & Partners
// ----------------------------------------------------

model ProductCategory {
  id          String    @id @default(uuid())
  code        String    @unique
  nameEn      String    @map("name_en")
  nameAr      String    @map("name_ar")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  products    Product[]

  @@map("product_categories")
}

model UnitOfMeasure {
  id        String    @id @default(uuid())
  code      String    @unique // CARTON, BOTTLE, PACK, KG
  nameEn    String    @map("name_en")
  nameAr    String    @map("name_ar")

  products  Product[]

  @@map("units_of_measure")
}

model Supplier {
  id               String            @id @default(uuid())
  code             String            @unique
  companyName      String            @map("company_name")
  taxId            String?           @map("tax_id")
  commercialReg    String?           @map("commercial_reg")
  paymentTermsDays Int               @default(30) @map("payment_terms_days")
  contactName      String?           @map("contact_name")
  phone            String?
  email            String?
  address          String?
  city             String?
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")

  products         Product[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
}

model Product {
  id                     String          @id @default(uuid())
  categoryId             String          @map("category_id")
  uomId                  String          @map("uom_id")
  supplierId             String?         @map("supplier_id")
  sku                    String          @unique
  barcode                String?         @unique
  nameEn                 String          @map("name_en")
  nameAr                 String          @map("name_ar")
  brand                  String?
  caseSize               Int             @default(1) @map("case_size")
  reorderPoint           Int             @default(50) @map("reorder_point")
  costPrice              Decimal         @db.Decimal(12, 4) @map("cost_price") // Standard or current replenishment cost
  sellingPrice           Decimal         @db.Decimal(14, 2) @map("selling_price")
  minPrice               Decimal         @db.Decimal(14, 2) @map("min_price")
  requiresExpiryTracking Boolean         @default(true) @map("requires_expiry_tracking")
  isActive               Boolean         @default(true) @map("is_active")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  category               ProductCategory @relation(fields: [categoryId], references: [id])
  uom                    UnitOfMeasure   @relation(fields: [uomId], references: [id])
  supplier               Supplier?       @relation(fields: [supplierId], references: [id])

  batches                InventoryBatch[]
  movements              InventoryMovement[]
  invoiceLines           SalesInvoiceLine[]
  returnLines            SalesReturnLine[]
  purchaseLines          PurchaseInvoiceLine[]
  adjustments            StockAdjustment[]

  @@map("products")
}

model Customer {
  id           String            @id @default(uuid())
  branchId     String            @map("branch_id")
  code         String            @unique
  name         String
  customerType String            @default("SUPERMARKET") @map("customer_type") // SUPERMARKET, WHOLESALER, GROCERY
  taxId        String?           @map("tax_id")
  phone        String?
  address      String?
  creditLimit  Decimal           @default(50000.00) @db.Decimal(14, 2) @map("credit_limit")
  creditDays   Int               @default(30) @map("credit_days")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")

  branch       Branch            @relation(fields: [branchId], references: [id])
  invoices     SalesInvoice[]
  payments     CustomerPayment[]
  returns      SalesReturn[]
  creditNotes  CreditNote[]

  @@map("customers")
}

model Warehouse {
  id          String              @id @default(uuid())
  branchId    String              @map("branch_id")
  code        String              @unique
  name        String
  location    String?
  capacitySqm Int?                @map("capacity_sqm")
  isActive    Boolean             @default(true) @map("is_active")

  branch      Branch              @relation(fields: [branchId], references: [id])

  batches     InventoryBatch[]
  movements   InventoryMovement[]
  transfersFrom StockTransfer[]   @relation("FromWarehouse")
  transfersTo   StockTransfer[]   @relation("ToWarehouse")
  adjustments StockAdjustment[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@map("warehouses")
}

// ----------------------------------------------------
// Sales & Accounts Receivable
// ----------------------------------------------------

enum InvoicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELED
}

model SalesInvoice {
  id                    String               @id @default(uuid())
  invoiceNumber         String               @unique @map("invoice_number")
  branchId              String               @map("branch_id")
  customerId            String               @map("customer_id")
  salesRepresentativeId String               @map("sales_representative_id")
  invoiceDate           DateTime             @default(now()) @map("invoice_date")
  dueDate               DateTime             @map("due_date")
  grossAmount           Decimal              @db.Decimal(14, 2) @map("gross_amount")
  discountAmount        Decimal              @default(0.00) @db.Decimal(14, 2) @map("discount_amount")
  taxAmount             Decimal              @default(0.00) @db.Decimal(14, 2) @map("tax_amount")
  netAmount             Decimal              @db.Decimal(14, 2) @map("net_amount")
  cogsAmount            Decimal              @db.Decimal(14, 2) @map("cogs_amount")
  paidAmount            Decimal              @default(0.00) @db.Decimal(14, 2) @map("paid_amount")
  balanceDue            Decimal              @db.Decimal(14, 2) @map("balance_due")
  paymentStatus         InvoicePaymentStatus @default(UNPAID) @map("payment_status")
  status                InvoiceStatus        @default(ISSUED)
  notes                 String?
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  branch                Branch               @relation(fields: [branchId], references: [id])
  customer              Customer             @relation(fields: [customerId], references: [id])
  salesRepresentative   SalesRepresentative  @relation(fields: [salesRepresentativeId], references: [id])

  lines                 SalesInvoiceLine[]
  allocations           PaymentAllocation[]
  returns               SalesReturn[]
  deliveries            Delivery[]
  discountApprovals     DiscountApproval[]

  @@index([branchId, invoiceDate])
  @@index([customerId, paymentStatus])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id              String       @id @default(uuid())
  salesInvoiceId  String       @map("sales_invoice_id")
  productId       String       @map("product_id")
  quantity        Int
  unitPrice       Decimal      @db.Decimal(14, 2) @map("unit_price")
  unitCost        Decimal      @db.Decimal(12, 4) @map("unit_cost")
  discountPercent Decimal      @default(0.00) @db.Decimal(5, 2) @map("discount_percent")
  discountAmount  Decimal      @default(0.00) @db.Decimal(14, 2) @map("discount_amount")
  lineTotal       Decimal      @db.Decimal(14, 2) @map("line_total")
  lineCogs        Decimal      @db.Decimal(14, 2) @map("line_cogs")
  createdAt       DateTime     @default(now()) @map("created_at")

  salesInvoice    SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id])

  @@map("sales_invoice_lines")
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockDisposition {
  RETURN_TO_STOCK
  QUARANTINE_DAMAGED
  SCRAPPED
}

model ReturnReason {
  id                       String            @id @default(uuid())
  code                     String            @unique // DAMAGED, EXPIRED, CUSTOMER_REFUSAL, ORDER_ERROR
  nameEn                   String            @map("name_en")
  nameAr                   String            @map("name_ar")
  requiresManagerApproval  Boolean           @default(false) @map("requires_manager_approval")

  returnLines              SalesReturnLine[]

  @@map("return_reasons")
}

model SalesReturn {
  id                 String            @id @default(uuid())
  returnNumber       String            @unique @map("return_number")
  salesInvoiceId     String            @map("sales_invoice_id")
  branchId           String            @map("branch_id")
  customerId         String            @map("customer_id")
  returnDate         DateTime          @default(now()) @map("return_date")
  totalAmount        Decimal           @db.Decimal(14, 2) @map("total_amount")
  totalCost          Decimal           @db.Decimal(14, 2) @map("total_cost")
  status             ReturnStatus      @default(PENDING)
  approvedByUserId   String?           @map("approved_by_user_id")
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")

  salesInvoice       SalesInvoice      @relation(fields: [salesInvoiceId], references: [id])
  branch             Branch            @relation(fields: [branchId], references: [id])
  customer           Customer          @relation(fields: [customerId], references: [id])
  approvedByUser     User?             @relation("ApprovedReturns", fields: [approvedByUserId], references: [id])

  lines              SalesReturnLine[]
  creditNotes        CreditNote[]

  @@map("sales_returns")
}

model SalesReturnLine {
  id               String           @id @default(uuid())
  salesReturnId    String           @map("sales_return_id")
  productId        String           @map("product_id")
  returnReasonId   String           @map("return_reason_id")
  quantity         Int
  unitPrice        Decimal          @db.Decimal(14, 2) @map("unit_price")
  unitCost         Decimal          @db.Decimal(12, 4) @map("unit_cost")
  lineTotal        Decimal          @db.Decimal(14, 2) @map("line_total")
  lineCost         Decimal          @db.Decimal(14, 2) @map("line_cost")
  stockDisposition StockDisposition @default(RETURN_TO_STOCK) @map("stock_disposition")

  salesReturn      SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])
  returnReason     ReturnReason     @relation(fields: [returnReasonId], references: [id])

  @@map("sales_return_lines")
}

model DiscountApproval {
  id                 String       @id @default(uuid())
  salesInvoiceId     String       @map("sales_invoice_id")
  requestedByUserId  String       @map("requested_by_user_id")
  approvedByUserId   String?      @map("approved_by_user_id")
  discountPercent    Decimal      @db.Decimal(5, 2) @map("discount_percent")
  discountAmount     Decimal      @db.Decimal(14, 2) @map("discount_amount")
  status             String       @default("PENDING") // PENDING, APPROVED, REJECTED
  reason             String?
  actionDate         DateTime?    @map("action_date")
  createdAt          DateTime     @default(now()) @map("created_at")

  salesInvoice       SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  requestedByUser    User         @relation("RequestedDiscounts", fields: [requestedByUserId], references: [id])
  approvedByUser     User?        @relation("ApprovedDiscounts", fields: [approvedByUserId], references: [id])

  @@map("discount_approvals")
}

// ----------------------------------------------------
// Inventory, Batch Tracking & Movements
// ----------------------------------------------------

enum BatchStatus {
  ACTIVE
  EXPIRED
  DEPLETED
}

model InventoryBatch {
  id                String              @id @default(uuid())
  productId         String              @map("product_id")
  warehouseId       String              @map("warehouse_id")
  batchNumber       String              @map("batch_number")
  manufactureDate   DateTime?           @map("manufacture_date")
  expiryDate        DateTime            @map("expiry_date")
  quantityReceived  Int                 @map("quantity_received")
  quantityAvailable Int                 @map("quantity_available")
  unitCost          Decimal             @db.Decimal(12, 4) @map("unit_cost")
  status            BatchStatus         @default(ACTIVE)
  createdAt         DateTime            @default(now()) @map("created_at")

  product           Product             @relation(fields: [productId], references: [id])
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])

  movements         InventoryMovement[]

  @@unique([warehouseId, productId, batchNumber])
  @@index([productId, expiryDate])
  @@map("inventory_batches")
}

enum MovementType {
  RECEIPT
  DISPATCH
  RETURN
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  TRANSFER_IN
  TRANSFER_OUT
}

model InventoryMovement {
  id             String          @id @default(uuid())
  warehouseId    String          @map("warehouse_id")
  productId      String          @map("product_id")
  batchId        String?         @map("batch_id")
  movementType   MovementType    @map("movement_type")
  referenceType  String          @map("reference_type") // SALES_INVOICE, PURCHASE_INVOICE, SALES_RETURN, etc.
  referenceId    String          @map("reference_id")
  quantityChange Int             @map("quantity_change") // Signed integer (+ or -)
  unitCost       Decimal         @db.Decimal(12, 4) @map("unit_cost")
  totalCost      Decimal         @db.Decimal(14, 2) @map("total_cost")
  balanceAfter   Int             @map("balance_after")
  timestamp      DateTime        @default(now())
  createdById    String?         @map("created_by_id")

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  batch          InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([warehouseId, productId, timestamp])
  @@map("inventory_movements")
}

model StockTransfer {
  id              String    @id @default(uuid())
  transferNumber  String    @unique @map("transfer_number")
  fromWarehouseId String    @map("from_warehouse_id")
  toWarehouseId   String    @map("to_warehouse_id")
  status          String    @default("DRAFT") // DRAFT, IN_TRANSIT, COMPLETED, CANCELED
  sentDate        DateTime? @map("sent_date")
  receivedDate    DateTime? @map("received_date")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  fromWarehouse   Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  @@map("stock_transfers")
}

model StockAdjustment {
  id               String    @id @default(uuid())
  warehouseId      String    @map("warehouse_id")
  productId        String    @map("product_id")
  adjustmentType   String    @map("adjustment_type") // DAMAGE, COUNT_VARIANCE, EXPIRY
  quantityDelta    Int       @map("quantity_delta") // Signed integer
  unitCost         Decimal   @db.Decimal(12, 4) @map("unit_cost")
  approvedByUserId String?   @map("approved_by_user_id")
  notes            String?
  timestamp        DateTime  @default(now())

  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])
  approvedByUser   User?     @relation(fields: [approvedByUserId], references: [id])

  @@map("stock_adjustments")
}

// ----------------------------------------------------
// Purchasing & Procurement
// ----------------------------------------------------

model PurchaseOrder {
  id                   String            @id @default(uuid())
  poNumber             String            @unique @map("po_number")
  supplierId           String            @map("supplier_id")
  warehouseId          String            @map("warehouse_id")
  orderDate            DateTime          @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?         @map("expected_delivery_date")
  totalAmount          Decimal           @db.Decimal(14, 2) @map("total_amount")
  status               String            @default("ORDERED") // DRAFT, ORDERED, RECEIVED, CANCELED

  supplier             Supplier          @relation(fields: [supplierId], references: [id])
  warehouse            Warehouse         @relation(fields: [warehouseId], references: [id])

  invoices             PurchaseInvoice[]

  @@map("purchase_orders")
}

model PurchaseInvoice {
  id              String                @id @default(uuid())
  piNumber        String                @unique @map("pi_number")
  supplierId      String                @map("supplier_id")
  purchaseOrderId String?               @map("purchase_order_id")
  warehouseId     String                @map("warehouse_id")
  invoiceDate     DateTime              @default(now()) @map("invoice_date")
  totalAmount     Decimal               @db.Decimal(14, 2) @map("total_amount")
  paidAmount      Decimal               @default(0.00) @db.Decimal(14, 2) @map("paid_amount")
  paymentStatus   String                @default("UNPAID") @map("payment_status")
  status          String                @default("POSTED") // DRAFT, POSTED

  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])

  lines           PurchaseInvoiceLine[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                String          @id @default(uuid())
  purchaseInvoiceId String          @map("purchase_invoice_id")
  productId         String          @map("product_id")
  quantity          Int
  unitCost          Decimal         @db.Decimal(12, 4) @map("unit_cost")
  lineTotal         Decimal         @db.Decimal(14, 2) @map("line_total")
  batchNumber       String?         @map("batch_number")
  expiryDate        DateTime?       @map("expiry_date")

  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])

  @@map("purchase_invoice_lines")
}

// ----------------------------------------------------
// Financial Collections, Expenses & Budgets
// ----------------------------------------------------

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

model CustomerPayment {
  id                String              @id @default(uuid())
  paymentNumber     String              @unique @map("payment_number")
  customerId        String              @map("customer_id")
  branchId          String              @map("branch_id")
  paymentDate       DateTime            @default(now()) @map("payment_date")
  amount            Decimal             @db.Decimal(14, 2)
  paymentMethod     PaymentMethod       @default(CASH) @map("payment_method")
  referenceNumber   String?             @map("reference_number")
  unallocatedAmount Decimal             @default(0.00) @db.Decimal(14, 2) @map("unallocated_amount")
  notes             String?
  createdByUserId   String?             @map("created_by_user_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  customer          Customer            @relation(fields: [customerId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  createdByUser     User?               @relation(fields: [createdByUserId], references: [id])

  allocations       PaymentAllocation[]

  @@map("customer_payments")
}

model PaymentAllocation {
  id                String          @id @default(uuid())
  customerPaymentId String          @map("customer_payment_id")
  salesInvoiceId    String          @map("sales_invoice_id")
  allocatedAmount   Decimal         @db.Decimal(14, 2) @map("allocated_amount")
  createdAt         DateTime        @default(now()) @map("created_at")

  payment           CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)
  salesInvoice      SalesInvoice    @relation(fields: [salesInvoiceId], references: [id])

  @@map("payment_allocations")
}

model CreditNote {
  id               String       @id @default(uuid())
  creditNoteNumber String       @unique @map("credit_note_number")
  customerId       String       @map("customer_id")
  salesReturnId    String?      @map("sales_return_id")
  branchId         String       @map("branch_id")
  amount           Decimal      @db.Decimal(14, 2)
  issueDate        DateTime     @default(now()) @map("issue_date")
  remainingCredit  Decimal      @db.Decimal(14, 2) @map("remaining_credit")
  status           String       @default("OPEN") // OPEN, APPLIED, REFUNDED

  customer         Customer     @relation(fields: [customerId], references: [id])
  salesReturn      SalesReturn? @relation(fields: [salesReturnId], references: [id])
  branch           Branch       @relation(fields: [branchId], references: [id])

  @@map("credit_notes")
}

model ExpenseCategory {
  id                  String     @id @default(uuid())
  code                String     @unique // TRANSPORT, RENT, UTILITIES, SALARIES, MARKETING, GENERAL
  nameEn              String     @map("name_en")
  nameAr              String     @map("name_ar")
  isOperatingExpense  Boolean    @default(true) @map("is_operating_expense")

  expenses            Expenses[]
  budgets             BranchBudget[]

  @@map("expense_categories")
}

model Expenses {
  id                String          @id @default(uuid())
  branchId          String          @map("branch_id")
  categoryId        String          @map("category_id")
  expenseDate       DateTime        @default(now()) @map("expense_date")
  amount            Decimal         @db.Decimal(14, 2)
  recipientOrVendor String?         @map("recipient_or_vendor")
  paymentMethod     PaymentMethod   @default(CASH) @map("payment_method")
  approvedByUserId  String?         @map("approved_by_user_id")
  notes             String?
  receiptRef        String?         @map("receipt_ref")
  createdAt         DateTime        @default(now()) @map("created_at")

  branch            Branch          @relation(fields: [branchId], references: [id])
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  approvedByUser    User?           @relation(fields: [approvedByUserId], references: [id])

  @@map("expenses")
}

model BranchBudget {
  id           String          @id @default(uuid())
  branchId     String          @map("branch_id")
  categoryId   String          @map("category_id")
  periodYear   Int             @map("period_year")
  periodMonth  Int             @map("period_month")
  budgetAmount Decimal         @db.Decimal(14, 2) @map("budget_amount")
  createdAt    DateTime        @default(now()) @map("created_at")

  branch       Branch          @relation(fields: [branchId], references: [id])
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([branchId, categoryId, periodYear, periodMonth])
  @@map("branch_budgets")
}

// ----------------------------------------------------
// Commissions Engine & Logistics
// ----------------------------------------------------

model CommissionPolicy {
  id             String                  @id @default(uuid())
  code           String                  @unique // POLICY_GROSS, POLICY_NET_AFTER_DISCOUNT, POLICY_NET_AFTER_RETURNS, POLICY_PROFIT_BASED
  name           String
  description    String?
  ratePercentage Decimal                 @default(2.00) @db.Decimal(5, 2) @map("rate_percentage")
  isDefault      Boolean                 @default(false) @map("is_default")
  isActive       Boolean                 @default(true) @map("is_active")

  calculations   CommissionCalculation[]

  @@map("commission_policies")
}

model CommissionCalculation {
  id                    String                 @id @default(uuid())
  salesRepresentativeId String                 @map("sales_representative_id")
  periodYear            Int                    @map("period_year")
  periodMonth           Int                    @map("period_month")
  policyId              String                 @map("policy_id")
  eligibleBaseAmount    Decimal                @db.Decimal(14, 2) @map("eligible_base_amount")
  appliedRate           Decimal                @db.Decimal(5, 2) @map("applied_rate")
  calculatedCommission  Decimal                @db.Decimal(14, 2) @map("calculated_commission")
  recordedCommission    Decimal                @db.Decimal(14, 2) @map("recorded_commission")
  discrepancyAmount     Decimal                @db.Decimal(14, 2) @map("discrepancy_amount")
  status                String                 @default("DRAFT") // DRAFT, APPROVED, PAID
  approvedByUserId      String?                @map("approved_by_user_id")
  notes                 String?
  calculatedAt          DateTime               @default(now()) @map("calculated_at")

  salesRepresentative   SalesRepresentative    @relation(fields: [salesRepresentativeId], references: [id])
  policy                CommissionPolicy       @relation(fields: [policyId], references: [id])
  approvedByUser        User?                  @relation(fields: [approvedByUserId], references: [id])

  adjustments           CommissionAdjustment[]

  @@unique([salesRepresentativeId, periodYear, periodMonth])
  @@map("commission_calculations")
}

model CommissionAdjustment {
  id                      String                @id @default(uuid())
  commissionCalculationId String                @map("commission_calculation_id")
  adjustmentAmount        Decimal               @db.Decimal(14, 2) @map("adjustment_amount")
  reason                  String
  authorizedByUserId      String?               @map("authorized_by_user_id")
  createdAt               DateTime              @default(now()) @map("created_at")

  calculation             CommissionCalculation @relation(fields: [commissionCalculationId], references: [id], onDelete: Cascade)

  @@map("commission_adjustments")
}

enum DeliveryStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  FAILED
  DELAYED
}

model Delivery {
  id                 String         @id @default(uuid())
  salesInvoiceId     String         @map("sales_invoice_id")
  branchId           String         @map("branch_id")
  scheduledDate      DateTime       @map("scheduled_date")
  actualDeliveryDate DateTime?      @map("actual_delivery_date")
  status             DeliveryStatus @default(SCHEDULED)
  delayReason        String?        @map("delay_reason")
  driverName         String?        @map("driver_name")
  vehiclePlate       String?        @map("vehicle_plate")
  transportCost      Decimal        @default(0.00) @db.Decimal(14, 2) @map("transport_cost")

  salesInvoice       SalesInvoice   @relation(fields: [salesInvoiceId], references: [id])
  branch             Branch         @relation(fields: [branchId], references: [id])

  @@map("deliveries")
}

model OperationalAlert {
  id          String   @id @default(uuid())
  branchId    String?  @map("branch_id")
  alertType   String   @map("alert_type") // DUPLICATE_INVOICE, LOW_STOCK, EXPIRY_WARNING, UNALLOCATED_PAYMENT, UNAPPROVED_DISCOUNT, TARGET_RISK
  severity    String   @default("WARNING") // INFO, WARNING, CRITICAL
  title       String
  description String
  isResolved  Boolean  @default(false) @map("is_resolved")
  createdAt   DateTime @default(now()) @map("created_at")

  branch      Branch?  @relation(fields: [branchId], references: [id])

  @@map("operational_alerts")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  branchId   String?  @map("branch_id")
  action     String   // CREATE, UPDATE, DELETE, APPROVE, EXPORT, LOGIN
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id")
  details    Json?    // Detailed payload diff
  ipAddress  String?  @map("ip_address")
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])
  branch     Branch?  @relation(fields: [branchId], references: [id])

  @@index([entityName, timestamp])
  @@map("audit_logs")
}

model ImportJob {
  id           String        @id @default(uuid())
  filename     String
  jobType      String        @map("job_type") // INVOICES, PRODUCTS, CUSTOMERS
  totalRows    Int           @default(0) @map("total_rows")
  importedRows Int           @default(0) @map("imported_rows")
  rejectedRows Int           @default(0) @map("rejected_rows")
  status       String        @default("PENDING") // PENDING, VALIDATING, COMMITTED, FAILED
  userId       String?       @map("user_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id])
  errors       ImportError[]

  @@map("import_jobs")
}

model ImportError {
  id          String    @id @default(uuid())
  importJobId String    @map("import_job_id")
  rowNumber   Int       @map("row_number")
  fieldName   String?   @map("field_name")
  rawValue    String?   @map("raw_value")
  errorMessage String   @map("error_message")
  createdAt   DateTime  @default(now()) @map("created_at")

  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@map("import_errors")
}
